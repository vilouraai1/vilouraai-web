// Prisma schema for VilouraAI marketing site.
//
// DDL source of truth only. The runtime does NOT use the Prisma Client:
// it talks to Cloudflare D1 (SQLite) with raw SQL in src/server/db.ts.
// (The Prisma Client + D1 adapter path was tried and does not work under
// OpenNext on Workers — the query engine cannot load there; see
// ops/replies/muse-viloura-cf.md §6.) The datasource is declared as
// sqlite so `prisma migrate diff` produces D1-compatible DDL; at runtime
// the D1 binding supplies the database and DATABASE_URL is not used.
// Local Prisma CLI work (migrate diff, db push) can still point
// DATABASE_URL at a local file (file:./dev.db) — that file is gitignored
// and must never be committed.

generator client {
    provider = "prisma-client-js"
    output   = "../generated/prisma"
}

datasource db {
    provider = "sqlite"
    url      = env("DATABASE_URL")
}

model Lead {
    id        Int      @id @default(autoincrement())
    name      String
    email     String
    business  String?
    message   String?
    createdAt DateTime @default(now())

    @@index([email])
}

// Mirror of the Growth Dashboard artifact state, refreshed by sas's workers
// (5 AM daily run + task dispatcher) via POST /api/ops/sync. The /ops page
// reads this live so the phone view never needs a redeploy to stay fresh.
// Tables are created by the sync endpoint itself (raw SQL, IF NOT EXISTS)
// because local dev has no production DB access.
model OpsState {
    id        String   @id // always "dashboard"
    data      Json
    updatedAt DateTime @updatedAt @map("updated_at")

    @@map("ops_state")
}

// Commands issued from the /ops phone page (approve/edit). The dispatcher
// worker picks up unprocessed rows, applies them to the dashboard artifact,
// and marks them processed.
model OpsAction {
    id        Int      @id @default(autoincrement())
    action    String // "approve_item" | "edit_item"
    list      String // "website" | "business"
    itemId    String   @map("item_id")
    patch     Json?
    processed Boolean  @default(false)
    createdAt DateTime @default(now()) @map("created_at")

    @@index([processed, createdAt])
    @@map("ops_action")
}
